/* ==========================================================================
   ACZero Enhancer — Authentic Ace Combat Zero: The Belkan War UI Theme
   Path: mods\enhancer\ui\acz_theme.rcss
   Hot-Reload: Edit and save this file while the game is running to see live
   visual changes immediately — no recompilation required!
   ========================================================================== */

* {
    box-sizing: border-box;
}

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "ACZBody";
    color: #FFD938;
    background-color: transparent;
    overflow: hidden;
}

/* Layer 1: Primary ACZ crimson radial gradient + command center + tactical grid + scanline */
#bg-crimson {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
}

#bg-command-center {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.28;
    z-index: 1;
}

#bg-grid {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    decorator: image("assets/bg_grid_tile.png" none repeat);
    z-index: 2;
}

@keyframes acz-scan-sweep {
    0%   { top: 108%; opacity: 0.0; }
    2%   { opacity: 1.0; }
    17%  { top: -16%; opacity: 0.92; }
    19%  { top: -20%; opacity: 0.0; }
    100% { top: -20%; opacity: 0.0; }
}

#bg-scanline {
    position: absolute;
    left: 0;
    width: 100%;
    height: 135px;
    decorator: vertical-gradient(rgba(255, 224, 170, 108) rgba(255, 110, 50, 0));
    border-top: 2px rgba(255, 245, 215, 200);
    z-index: 3;
    animation: 9.0s linear infinite acz-scan-sweep;
}

#bg-sparks {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 4;
}

/* Top-left key/button prompt strip (OK | CANCEL | L1/R1) */
#top-prompts {
    position: absolute;
    z-index: 10;
    top: 4.8%;
    left: 4.8%;
    right: 4.8%;
    height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    font-family: "ACZTitle";
    font-size: 25px;
    letter-spacing: 2px;
    color: #F7C730;
}

.prompt-cap {
    display: inline-block;
    padding: 2px 9px;
    margin-right: 10px;
    border: 1px #D8A520;
    background-color: rgba(140, 95, 10, 120);
    color: #FFF2B8;
    font-size: 18px;
}

.prompt-sep {
    margin: 0 18px;
    color: rgba(242, 188, 36, 140);
}

.prompt-right {
    margin-left: auto;
    font-size: 18px;
    color: rgba(247, 199, 48, 190);
}

/* Main tactical folder frame */
#menu-frame {
    position: absolute;
    z-index: 10;
    top: 12.2%;
    left: 4.8%;
    right: 4.8%;
    bottom: 20.5%;
    display: flex;
    flex-direction: column;
    border: 1px rgba(210, 152, 22, 175);
    background-color: transparent;
}

/* Folder breadcrumb header bar: MAIN MENU > OPTIONS > ... */
#breadcrumb-bar {
    height: 40px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
    background-color: rgba(162, 114, 12, 118);
    border-bottom: 1px rgba(215, 158, 24, 190);
    font-family: "ACZBody";
    font-size: 17px;
    letter-spacing: 3px;
    color: #FAD03C;
}

.folder-tag {
    display: inline-block;
    padding: 1px 6px;
    margin-right: 12px;
    border: 1px #FAD03C;
    font-size: 13px;
    color: #FAD03C;
}

#toast-msg {
    margin-left: auto;
    font-size: 15px;
    letter-spacing: 2px;
    color: #7EFFB2;
}

/* Three-column ACZ folder body */
#columns {
    flex: 1;
    display: flex;
    flex-direction: row;
    width: 100%;
    overflow: hidden;
}

.col-left {
    width: 48%;
    height: 100%;
    border-right: 1px rgba(195, 140, 20, 140);
    padding: 10px 0;
    overflow: hidden;
}

.col-mid {
    width: 28%;
    height: 100%;
    border-right: 1px rgba(195, 140, 20, 110);
    padding: 10px 0;
    overflow: hidden;
}

.col-right {
    width: 24%;
    height: 100%;
    padding: 10px 18px;
    overflow: hidden;
}

/* Category & Option rows */
@keyframes acz-pulse {
    0%   { background-color: #F7C400; }
    50%  { background-color: #FFD93D; }
    100% { background-color: #F7C400; }
}

.cat-row {
    height: 58px;
    padding: 0 22px;
    display: flex;
    flex-direction: row;
    align-items: center;
    font-family: "ACZTitle";
    font-size: 27px;
    letter-spacing: 3px;
    color: #FFD630;
    transition: background-color 0.12s quadratic-out, color 0.12s quadratic-out;
}

.cat-row.selected {
    background-color: #F7C400;
    color: #2B1700;
    animation: 1.6s infinite acz-pulse;
}

.cat-row.dimmed {
    color: rgba(234, 180, 28, 125);
}

.cat-row.active-parent {
    background-color: rgba(247, 196, 0, 75);
    color: #FFE47A;
}

/* Sub-option rows (when inside a category or previewed in col 2) */
.opt-row {
    height: 46px;
    padding: 0 18px;
    display: flex;
    flex-direction: row;
    align-items: center;
    font-family: "ACZBody";
    font-size: 20px;
    letter-spacing: 1.5px;
    color: #E8B420;
}

.opt-row.preview {
    height: 36px;
    font-size: 16px;
    color: rgba(232, 180, 32, 175);
}

.opt-row.selected {
    background-color: #F7C400;
    color: #261400;
    animation: 1.6s infinite acz-pulse;
}

.opt-val {
    margin-left: auto;
    font-family: "ACZBody";
    font-size: 19px;
    letter-spacing: 1px;
}

.opt-row.selected .opt-val {
    color: #261400;
}

/* Right / middle column value preview / detail card */
.val-choice {
    height: 38px;
    padding: 0 20px;
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 19px;
    letter-spacing: 1.5px;
    color: rgba(232, 180, 32, 145);
}

.val-choice.active {
    color: #FFE878;
}

.badge {
    display: inline-block;
    margin-top: 14px;
    padding: 3px 10px;
    border: 1px #E8B420;
    font-size: 14px;
    letter-spacing: 2px;
    color: #FFE26A;
    background-color: rgba(160, 110, 10, 90);
}

.badge.instant {
    border-color: #5CE699;
    color: #80FFB8;
    background-color: rgba(20, 110, 60, 95);
}

.badge.restart {
    border-color: #FF6B5E;
    color: #FF9C92;
    background-color: rgba(130, 28, 22, 110);
}

.badge.mission {
    border-color: #FFBF3C;
    color: #FFE082;
    background-color: rgba(145, 92, 10, 110);
}

/* Slider bar in right column */
.slider-wrap {
    margin-top: 16px;
    width: 100%;
}

.slider-track {
    width: 100%;
    height: 14px;
    border: 1px #E8B420;
    background-color: rgba(45, 16, 4, 180);
}

.slider-fill {
    height: 100%;
    background-color: #F7C400;
}

/* Bottom description line (matching ACZ's "Adjust sound settings.") */
#footer-desc {
    position: absolute;
    z-index: 10;
    left: 5.0%;
    right: 5.0%;
    bottom: 13.5%;
    font-family: "ACZBody";
    font-size: 24px;
    letter-spacing: 1.5px;
    color: #F5C428;
}
