<rml>
<head>
    <title>ACZ Options</title>
    <link type="text/rcss" href="acz_theme.rcss" />
</head>
<body>
    <div id="top-prompts">
        <span class="prompt-cap" id="cap-ok">ENTER</span><span>OK</span>
        <span class="prompt-sep">|</span>
        <span class="prompt-cap" id="cap-cancel">ESC</span><span>CANCEL</span>
        <span class="prompt-sep">|</span>
        <span class="prompt-cap" id="cap-change">LT/RT</span><span>CHANGE</span>
        <span class="prompt-right" id="version-tag">ACZERO ENHANCER v0.25  [F5 HOT-RELOAD]</span>
    </div>

    <div id="menu-frame">
        <div id="breadcrumb-bar">
            <span class="folder-tag">DIR</span>
            <span id="breadcrumb-text">MAIN MENU &gt; OPTIONS</span>
            <span id="toast-msg"></span>
        </div>

        <div id="columns">
            <div class="col-left"  id="col-left"></div>
            <div class="col-mid"   id="col-mid"></div>
            <div class="col-right" id="col-right"></div>
        </div>
    </div>

    <div id="footer-desc">Select a category.</div>
</body>
</rml>
